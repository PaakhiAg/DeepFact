# ==============================================================================
# DeepFact — Retrieval-Augmented Fake News Detection & Verification
# Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration (Optional / Recommended for Live Production)
# Get a free key at: https://aistudio.google.com/app/apikey
# If omitted, DeepFact operates seamlessly using built-in semantic heuristic NLP.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Tavily Web Search API Configuration (Optional / Recommended for Live Web RAG)
# Get a free key at: https://tavily.com (1,000 free searches/month)
# If omitted, DeepFact automatically falls back to live DuckDuckGo open search
# retrieval with intelligent query reformulation.
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# Application Environment & Security
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Integration (Optional - for cloud production deployment)
# If omitted, DeepFact uses local persistent JSON database storage.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
